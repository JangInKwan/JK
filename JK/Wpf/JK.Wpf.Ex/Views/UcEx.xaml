<UserControl x:Class="JK.Wpf.Ex.Views.UcEx"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JK.Wpf.Ex.Views"
             mc:Ignorable="d" 
             d:DesignHeight="370" d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="15" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Margin="-5" BorderThickness="2" CornerRadius="5" BorderBrush="#464646" Grid.RowSpan="5" />

            <Button Grid.Row="0" Content="Test" Command="{Binding EncryptCommand}" CommandParameter="" Style="{DynamicResource CommonButton}" HorizontalAlignment="Right" Height="25" Width="100" Margin="0,-3,0,0"/>

            <TextBlock Grid.Row="0" Style="{DynamicResource CommonTextBlock}" HorizontalAlignment="Left" Padding="0,3,0,0">Test</TextBlock>
            <TextBox Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Text="{Binding Encrypt}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" />

            <TextBlock Grid.Row="2" Style="{DynamicResource CommonTextBlock}" HorizontalAlignment="Left" Padding="0,3,0,0">Test</TextBlock>
            <TextBox Grid.Row="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Text="{Binding EncryptText}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" IsReadOnly="True"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Margin="-5" BorderThickness="2" CornerRadius="5" BorderBrush="#464646" Grid.RowSpan="5" />

            <Button Grid.Row="0" Content="Test" Command="{Binding DecryptCommand}" CommandParameter="" Style="{DynamicResource CommonButton}" HorizontalAlignment="Right" Height="25" Width="100" Margin="0,-3,0,0"/>

            <TextBlock Grid.Row="0" Style="{DynamicResource CommonTextBlock}" HorizontalAlignment="Left" Padding="0,3,0,0">Test</TextBlock>
            <TextBox Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Text="{Binding Decrypt}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Visible"/>

            <TextBlock Grid.Row="2" Style="{DynamicResource CommonTextBlock}" HorizontalAlignment="Left" Padding="0,3,0,0">Test</TextBlock>
            <TextBox Grid.Row="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Text="{Binding DecryptText}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" IsReadOnly="True"/>
        </Grid>

    </Grid>
</UserControl>
