<Application x:Class="JK.Wpf.Ex.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converterBase="clr-namespace:JK.Wpf.Converters;assembly=JK.Wpf"
             xmlns:converter="clr-namespace:JK.Wpf.Ex.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBlocks.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converterBase:BindNotNullConverter x:Key="BindNotNullConverter"/>
            <converter:NavTypeToVisibleConverter x:Key="NavTypeToVisibleConverter"/>

            <FontFamily x:Key="Nanum">applicaton:,,,/Resources/Fonts/#나눔폰트</FontFamily>

        </ResourceDictionary>
    </Application.Resources>
</Application>
