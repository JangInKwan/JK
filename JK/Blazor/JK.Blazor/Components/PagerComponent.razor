@using Microsoft.AspNetCore.Components.Web

<ul class="pagination pagination-primary justify-content-center siteselect">
    @if (PageIndex == 1)
    {
        <li class="page-item disabled"><a class="page-link"><span aria-hidden="true"><i class="fa fa-angle-left"></i></span></a></li>
    }
    else
    {
        <li class="page-item"><a class="page-link" href="javascript:None();" @onclick="async () => { await OnSelectPage.InvokeAsync(PageIndex - 1); }"><span aria-hidden="true"><i class="fa fa-angle-left"></i></span></a></li>
    }

    @for (int i = StartPageNum; i <= EndPageNum; i++)
    {
        if (i == PageIndex)
        {
            <li class="page-item active"><a class="page-link">@i</a></li>
        }
        else
        {
            var page = i;
            <li class="page-item"><a class="page-link" href="javascript:None();" @onclick="async () => { await OnSelectPage.InvokeAsync(page); }">@i</a></li>
        }
    }

    @if (PageIndex == TotalPageCount)
    {
        <li class="page-item disabled"><a class="page-link"><span aria-hidden="true"><i class="fa fa-angle-right"></i></span></a></li>
    }
    else
    {
        <li class="page-item"><a class="page-link" href="javascript:None();" @onclick="async () => { await OnSelectPage.InvokeAsync(PageIndex + 1); }"><span aria-hidden="true"><i class="fa fa-angle-right"></i></span></a></li>
    }
</ul>


@code {

    /// <summary>
    /// 선택 페이지 번호
    /// </summary>
    [Parameter]
    public int PageIndex { get; set; } = 1;

    /// <summary>
    /// 총 아이템 수
    /// </summary>
    [Parameter]
    public int TotalCnt { get; set; } = 1;

    /// <summary>
    /// 페이지 사이즈
    /// </summary>
    [Parameter]
    public int PageSize { get; set; } = 20;

    /// <summary>
    /// 페이지 그룹 사이즈
    /// </summary>
    [Parameter]
    public int PageGroupSize { get; set; } = 5;

    /// <summary>
    /// 페이지 선택 이벤트
    /// </summary>
    [Parameter]
    public EventCallback<int> OnSelectPage { get; set; }

    /// <summary>
    /// 총 페이지 수
    /// </summary>
    public int TotalPageCount = 0;
    /// <summary>
    /// 시작 페이지 번호
    /// </summary>
    public int StartPageNum = 0;
    /// <summary>
    /// 마지막 페이지 번호
    /// </summary>
    public int EndPageNum = 0;

    protected override void OnParametersSet()
    {
        PagingView();
    }

    /// <summary>
    /// 페이지 화면
    /// </summary>
    private void PagingView()
    {
        if (TotalCnt == 0)
        {
            TotalCnt = 1;
        }

        TotalPageCount = TotalCnt / PageSize;

        if (TotalCnt % PageSize != 0)
            TotalPageCount++;

        if (TotalPageCount == 0)
            TotalPageCount = 1;

        StartPageNum = Decimal.ToInt32(Math.Floor((decimal)(PageIndex - 1) / PageGroupSize) * PageGroupSize + 1);
        EndPageNum = Decimal.ToInt32(Math.Min(StartPageNum + PageGroupSize - 1, TotalPageCount));
    }

}
