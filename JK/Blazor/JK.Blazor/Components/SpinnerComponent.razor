@using Microsoft.AspNetCore.Components.Web
@using JK.Blazor.Components
@using Microsoft.JSInterop
@using JK.Blazor.Data

@inject SpinnerService SpinnerService
@inject IJSRuntime JSRuntime;

@implements IDisposable


<div class="loading_wrap @ActiveClass">
    <div class="overlay"></div>

    <div class="wrapper loading_box">
        <div class="spinner-border" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
</div>


<style>
    .loading_wrap {
        position: fixed !important;
        visibility: hidden;
        opacity: 0;
        -webkit-transition: all 0.3s;
        -moz-transition: all 0.3s;
        transition: all 0.3s;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        z-index: 10000
    }

    .loading_box {
        z-index: 10001
    }

    .loading_wrap .overlay {
        position: fixed;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 10000;
        top: 0;
        left: 0;
    }

    .loading_wrap .wrapper {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 300px;
        text-align: center;
        transform: translateX(-50%);
    }

        .loading_wrap .wrapper .spinner-border {
            color: #b7b6b6;
            width: 3rem;
            height: 3rem;
        }

    .loading_wrap.active {
        visibility: visible;
        opacity: 1
    }
</style>

@code {
    /// <summary>
    /// Activec Class
    /// </summary>
    private string ActiveClass { get; set; } = "";

    protected override void OnInitialized()
    {
        SpinnerService.SpinnerRequested += Requested;
    }

    public void Dispose()
    {
        SpinnerService.SpinnerRequested -= Requested;
    }

    /// <summary>
    /// Spinner 상태 변경 이벤트
    /// </summary>
    /// <returns></returns>
    private async Task Requested(bool visibility)
    {
        await Task.Run(() =>
        {
            if (visibility)
            {
                ActiveClass = "active";
            }
            else
            {
                ActiveClass = "";
            }
        });

        StateHasChanged();
    }
}
