@using Microsoft.AspNetCore.Components.Web
@using JK.Blazor.Components
@using Microsoft.JSInterop
@using JK.Blazor.Data

@inject DialogService DialogService
@inject IJSRuntime JSRuntime;

@implements IDisposable

<div class="modal" id="popDialog" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document" style="width:400px">
        <div class="modal-content">
            <div class="modal-body" style="height:100px">
                @DialogService.Data.Content
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal" @onclick="OnOk">@DialogService.Data.TextOK</button>
                @if (VisibilityCancelButton)
                {
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" @onclick="OnCancel">@DialogService.Data.TextCancel</button>
                }
            </div>
        </div>
    </div>
</div>

@code {

    /// <summary>
    /// 취소 버튼 Visibility
    /// </summary>
    private bool VisibilityCancelButton { get; set; } = false;

    protected override void OnInitialized()
    {
        DialogService.RefreshRequested += Refresh;
    }

    public void Dispose()
    {
        DialogService.RefreshRequested -= Refresh;
    }

    /// <summary>
    /// 확인 버튼 이벤트
    /// </summary>
    /// <returns></returns>
    private async Task OnOk()
    {
        await JSRuntime.InvokeVoidAsync("CloseDialog");
        DialogService.Tcs.SetResult(true);
    }

    /// <summary>
    /// 취소 버튼 이벤트
    /// </summary>
    /// <returns></returns>
    private async Task OnCancel()
    {
        await JSRuntime.InvokeVoidAsync("CloseDialog");
        DialogService.Tcs.SetResult(false);
    }

    /// <summary>
    /// Dialog 상태 변경 이벤트
    /// </summary>
    /// <returns></returns>
    private async void Refresh()
    {
        if (DialogService.DialogType == DialogType.Alert)
        {
            VisibilityCancelButton = false;
        }
        else
        {
            VisibilityCancelButton = true;
        }


        StateHasChanged();

        await JSRuntime.InvokeVoidAsync("ShowDialog");
    }
}